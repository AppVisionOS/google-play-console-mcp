# Path to the Google Cloud Service Account JSON key file
# The service account needs:
#   - Google Play Android Developer API access
#   - Google Play Developer Reporting API access
#   - Google Cloud Storage read access (for financial reports)
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json

# Your Google Play Developer ID (numeric, found in Play Console URL)
# Required for accessing financial reports via GCS
GOOGLE_PLAY_DEVELOPER_ID=YOUR_DEVELOPER_ID

# Default package name (e.g. com.example.app)
# Used as the default when package_name parameter is not provided
GOOGLE_PLAY_PACKAGE_NAME=com.zona.aimusic

# Legacy/external GCS bucket support (optional)
# If the app was transferred from another Google Play Console account,
# historical financial reports remain in the old account's GCS bucket.
# Set these to access earnings/sales data from the previous account.
# GOOGLE_PLAY_LEGACY_DEVELOPER_ID=OLD_DEVELOPER_ID
# GOOGLE_PLAY_LEGACY_SERVICE_ACCOUNT_KEY=/path/to/old-service-account-key.json
